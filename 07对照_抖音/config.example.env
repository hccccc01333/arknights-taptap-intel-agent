# 可选：浏览器 Cookie（仅本地使用，切勿提交真实值）
# 从 douyin.com 已登录页面复制 Cookie，可提高搜索/评论成功率
DOUYIN_COOKIE=

# 可选：自定义 User-Agent
DOUYIN_UA=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36

# 限速（秒）：请求间隔下限 / 抖动上限
DOUYIN_SLEEP_MIN=1.2
DOUYIN_SLEEP_MAX=2.4

# 搜索关键词（逗号分隔）
DOUYIN_KEYWORDS=明日方舟,明日方舟 抽卡,明日方舟 七周年,明日方舟终末地

# 固定 aweme_id（逗号分隔）；搜索被风控时优先用这批公开视频拉评论
# 来源：公开分享页 URL（www.douyin.com/video/<id>）
DOUYIN_AWEME_IDS=7644551815031213346,7643769364273821658,7650357747275386175,7646759737765186862,7644071936439389503,7634965899007471590,7635290343324233458,7632697652707553198,7635603742066347273,7635319585511689523

# 直播抓取失败时是否启用演示种子语料（默认 1）
DOUYIN_ALLOW_FALLBACK_SEED=1
