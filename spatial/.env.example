# 复制为 .env.local。true 使用明确标注的演示数据；false 连接 FastAPI。
VITE_DEMO_MODE=true

# 独立部署后端时填 HTTPS 地址（不含末尾 /api）。本地使用 Vite proxy 时留空。
VITE_API_BASE_URL=
VITE_PUBLIC_RESULTS_URL=

# 本地为 /。Pages workflow 会自动读取站点路径，支持项目子路径和自定义域名。
VITE_BASE_PATH=/

# 仅本地开发服务器使用，不参与 GitHub Pages 代理。
VITE_DEV_API_TARGET=http://127.0.0.1:8200
