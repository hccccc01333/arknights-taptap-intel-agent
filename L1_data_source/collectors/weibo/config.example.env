# 可选：浏览器 Cookie（仅本地使用，切勿提交真实值）
# 从 m.weibo.cn / weibo.com 已登录页面复制 Cookie 可提升搜索/评论成功率
WEIBO_COOKIE=

# 可选：自定义 User-Agent（移动端更易过 m.weibo.cn）
WEIBO_UA=Mozilla/5.0 (iPhone; CPU iPhone OS 16_6 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/16.6 Mobile/15E148 Safari/604.1

# 限速（秒）：请求间隔下限 / 抖动上限（微博风控较严，默认偏保守）
WEIBO_SLEEP_MIN=1.2
WEIBO_SLEEP_MAX=2.4

# 搜索关键词（逗号分隔）
WEIBO_KEYWORDS=明日方舟,明日方舟 抽卡,明日方舟 活动,明日方舟 剧情

# 可选：超话 / 话题 containerid（搜索失败时降级；可留空）
# 示例：明日方舟超话常见形态 containerid=100808xxxxxx，以实测为准
WEIBO_TOPIC_CONTAINERIDS=

# 可选：相关用户 uid（搜索失败时拉时间线；默认官号，失效可改）
WEIBO_UIDS=6441486180
