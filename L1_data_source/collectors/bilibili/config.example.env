# 可选：浏览器 Cookie（仅本地使用，切勿提交真实值）
# 从 bilibili.com 已登录页面复制 Cookie 可提升搜索/评论成功率
BILI_COOKIE=

# 可选：自定义 User-Agent
BILI_UA=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36

# 限速（秒）：请求间隔下限 / 抖动上限
BILI_SLEEP_MIN=0.8
BILI_SLEEP_MAX=1.6

# 搜索关键词（逗号分隔）
BILI_KEYWORDS=明日方舟,明日方舟 活动,明日方舟 抽卡

# 可选：官方/相关 UP 的 mid，用于降级拉稿（无需搜索 WBI）
# 明日方舟官方账号常见 mid=161775300（若失效可改）
BILI_UP_MIDS=161775300
