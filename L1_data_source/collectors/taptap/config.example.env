# TapTap Web API identity string from browser Network panel.
# Copy the X-UA query value (decoded) from a successful review list request.
TAPTAP_X_UA=V=1&PN=WebApp&LANG=zh_CN&VN_CODE=102&LOC=CN&PLT=PC&DS=PC&UID=your-uid&OS=Windows&OSV=10&VID=0&DT=PC

# Salt for hashing user identifiers before they enter any analysis output.
# Leave it empty and pii_hash.py will generate one and write it back here on first run.
# CAUTION: changing this salt invalidates ALL previously computed hashes (recompute required).
TAPTAP_HASH_SALT=
